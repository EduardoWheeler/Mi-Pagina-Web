QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

QLineEdit {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 8px;
    color: #cdd6f4;
}

QPushButton {
    background-color: #89b4fa;
    color: #11111b;
    border-radius: 5px;
    padding: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #b4befe;
}